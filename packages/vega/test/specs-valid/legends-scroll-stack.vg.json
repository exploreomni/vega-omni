{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two legends stacked in the top slot share its height, and the scrolling one widens to the slot.",
  "width": 200,
  "height": 150,
  "padding": 5,
  "autosize": "pad",
  "data": [
    {
      "name": "source",
      "transform": [
        {
          "type": "sequence",
          "start": 1,
          "stop": 25,
          "as": "x"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "source",
        "field": "x"
      },
      "range": "width"
    },
    {
      "name": "color",
      "type": "ordinal",
      "range": {
        "scheme": "category20"
      },
      "domain": {
        "data": "source",
        "field": "x"
      }
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom"
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Scrolls",
      "orient": "top",
      "direction": "horizontal",
      "columns": "auto",
      "symbolLimit": 0,
      "maxWidth": 200,
      "maxHeight": 80,
      "scrollbarColor": "gray"
    },
    {
      "fill": "color",
      "title": "Few",
      "orient": "top",
      "direction": "horizontal",
      "columns": "auto",
      "symbolLimit": 3,
      "maxWidth": 200,
      "maxHeight": 80
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {
        "data": "source"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "x"
          },
          "y": {
            "value": 75
          },
          "fill": {
            "scale": "color",
            "field": "x"
          }
        }
      }
    }
  ],
  "config": {
    "legend": {
      "layout": {
        "top": {
          "direction": "vertical"
        }
      }
    }
  }
}
